table financials
	lineageTag: 7a454d14-3d00-43fb-8c83-0e8e30d06368

	measure Companies = DISTINCTCOUNT(financials[Symbol])
		formatString: #,0
		lineageTag: 3f1c2a10-5b7e-4d21-9a6c-1e2f3a4b5c01

	measure 'Total Market Cap' = SUM(financials[Market Cap])
		formatString: $#,0
		lineageTag: 3f1c2a10-5b7e-4d21-9a6c-1e2f3a4b5c02

	measure 'Total EBITDA' = SUM(financials[EBITDA])
		formatString: $#,0
		lineageTag: 3f1c2a10-5b7e-4d21-9a6c-1e2f3a4b5c03

	measure 'Avg P/E' = AVERAGE(financials[Price/Earnings])
		formatString: 0.0
		lineageTag: 3f1c2a10-5b7e-4d21-9a6c-1e2f3a4b5c04

	measure 'Avg Dividend Yield %' = AVERAGE(financials[Dividend Yield])
		formatString: 0.00
		lineageTag: 3f1c2a10-5b7e-4d21-9a6c-1e2f3a4b5c05

